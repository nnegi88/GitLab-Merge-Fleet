{
  "name": "gitlab-merge-fleet",
  "version": "0.1.0",
  "description": "A modern GitLab multi-repository merge request management tool with AI-powered code reviews",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && npx gh-pages -d dist",
    "test": "npm run test:unit && npm run test:component",
    "test:unit": "vitest run --coverage=false tests/unit",
    "test:component": "vitest run --coverage=false tests/component",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@sentry/vue": "^7.108.0",
    "@tanstack/vue-query": "^5.104.0",
    "axios": "^1.6.8",
    "lucide-vue-next": "^0.330.0",
    "marked": "^18.0.14",
    "pinia": "^2.1.7",
    "vue": "^3.5.43",
    "vue-router": "^4.2.5",
    "vuetify": "^3.8.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.26.0",
    "globals": "^16.2.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^7.0.4",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.11"
  }
}
